{
  "name": "claude-history-mcp",
  "version": "0.1.0",
  "description": "MCP server for searching and surfacing Claude Code conversation history",
  "type": "module",
  "license": "MIT",
  "author": "Jon Hammant",
  "repository": {
    "type": "git",
    "url": "https://github.com/jhammant/ClaudeHistoryMCP.git"
  },
  "keywords": [
    "mcp",
    "claude",
    "history",
    "search",
    "claude-code",
    "model-context-protocol"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "commands/",
    "README.md"
  ],
  "main": "dist/index.js",
  "bin": {
    "claude-history-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test",
    "build-index": "tsx src/cli/build-index.ts",
    "install-hook": "tsx src/cli/install.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "msgpackr": "^1.11.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
